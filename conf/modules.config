/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // QC
    withName: 'SHERLOCK_QC'{

        // extra args
        ext.args = {
            def flags = []
            flags << "--target-genome-build ${params.target_build}"
            flags << "--maf-thresh ${params.qc_maf_thresh}"

            if (params.qc_info_thresh != null) { flags << "--info-thresh ${params.qc_info_thresh}" }

            if (params.qc_drop_indels) { flags << "--drop-indels" }
            else                       { flags << "--no-drop-indels" }

            if (params.qc_drop_palindromes) { flags << "--drop-palindromes" }
            else                            { flags << "--no-drop-palindromes" }

            if (params.qc_drop_multiallelic) { flags << "--drop-multiallelic" }
            else                             { flags << "--no-drop-multiallelic" }

            if (params.qc_drop_non_autosomal) { flags << "--drop-non-autosomal" }
            else                              { flags << "--no-drop-non-autosomal" }

            if (params.qc_drop_mhc) { flags << "--drop-mhc" }
            else                    { flags << "--no-drop-mhc" }

            if (params.qc_drop_apoe) { flags << "--drop-apoe" }
            else                     { flags << "--no-drop-apoe" }

            flags.join(' ')
        }

        // results/traits/AD/qc/AD.qc.tsv.gz, AD.qc_summary.tsv
        publishDir = [
            path: { "${params.outdir}/traits/${meta.id}/qc" },
            mode: params.publish_dir_mode,
            pattern: '*.qc{.tsv.gz,_summary.tsv}'
        ]
    }

    // MUNGE
    withName: 'SHERLOCK_MUNGE' {

        // results/traits/AD/munge/AD.sumstats.gz, AD_munge.log
        publishDir = [
            path: { "${params.outdir}/traits/${meta.id}/munge" },
            mode: params.publish_dir_mode,
            pattern: '{*.sumstats.gz,*_munge.log}'
        ]
    }

    // LDSC
    withName: 'SHERLOCK_LDSC' {

        // results/pairs/AD_SCZ/rg/ldsc/AD_SCZ.ldsc.tsv, AD_SCZ_ldsc.log
        publishDir = [
            path: { "${params.outdir}/pairs/${meta1.id}_${meta2.id}/rg/ldsc" },
            mode: params.publish_dir_mode,
            pattern: '{*.ldsc.tsv,*_ldsc.log}'
        ]
    }

    // HDL
    withName: 'SHERLOCK_HDL' {

        // --n-ref only if rg_hdl_nref is set (else the script's UKB default, 335265)
        ext.args = {
            def args = []
            if (params.rg_hdl_nref != null) { args << "--n-ref ${params.rg_hdl_nref}" }
            args.join(' ')
        }

        // results/pairs/AD_SCZ/rg/hdl/AD_SCZ.hdl.tsv, AD_SCZ_hdl.log
        publishDir = [
            path: { "${params.outdir}/pairs/${meta1.id}_${meta2.id}/rg/hdl" },
            mode: params.publish_dir_mode,
            pattern: '{*.hdl.tsv,*_hdl.log}'
        ]
    }

    // HDL-L (local rg)
    withName: 'SHERLOCK_HDLL' {

        // --n0 only if lrg_hdll_n0 is set (else the script default, 0 = no overlap)
        ext.args = {
            def args = []
            if (params.lrg_hdll_n0 != null) { args << "--n0 ${params.lrg_hdll_n0}" }
            args.join(' ')
        }

        // ~3 GB peak on AD/SCZ; process_medium would ask for 36 GB
        memory = 8.GB

        // results/pairs/AD_SCZ/lrg/hdll/AD_SCZ.hdll.tsv, AD_SCZ_hdll.log
        publishDir = [
            path: { "${params.outdir}/pairs/${meta1.id}_${meta2.id}/lrg/hdll" },
            mode: params.publish_dir_mode,
            pattern: '{*.hdll.tsv,*_hdll.log}'
        ]
    }
}
