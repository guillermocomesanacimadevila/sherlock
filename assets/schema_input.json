{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/sherlock/master/assets/schema_input.json",
    "title": "nf-core/sherlock pipeline - params.input schema",
    "description": "GWAS samplesheet: one row per trait per pair. Rows with the same 'pair' value form one trait pair; without a 'pair' column, exactly two rows = one pair",
    "type": "array",
    "minItems": 2,
    "uniqueEntries": ["pair", "trait"],
    "items": {
        "type": "object",
        "properties": {
            "pair": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Pair label cannot contain spaces (e.g. AD_SCZ or 1)",
                "meta": ["pair"]
            },
            "trait": {
                "type": "string",
                "pattern": "^[^\\s_]+$",
                "errorMessage": "Trait name must be given and cannot contain spaces or '_'",
                "meta": ["id"]
            },
            "sumstats": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(tsv|txt|csv)(\\.gz)?$",
                "errorMessage": "Sumstats must be a .tsv/.txt/.csv (optionally .gz) file with no spaces in the path"
            },
            "build": {
                "type": "string",
                "enum": ["GRCh37", "GRCh38"],
                "errorMessage": "Genome build must be GRCh37 or GRCh38",
                "meta": ["build"]
            },
            "trait_type": {
                "type": "string",
                "enum": ["quant", "cc"],
                "errorMessage": "Trait type must be 'quant' (quantitative) or 'cc' (case/control)",
                "meta": ["trait_type"]
            },
            "n": {
                "type": "integer",
                "minimum": 1,
                "errorMessage": "n must be a whole number >= 1",
                "meta": ["n"]
            },
            "n_cases": {
                "type": "integer",
                "minimum": 1,
                "errorMessage": "n_cases must be a number (e.g. 21982), not a column name. For a per-SNP sample size column use n_col",
                "meta": ["n_cases"]
            },
            "n_controls": {
                "type": "integer",
                "minimum": 1,
                "errorMessage": "n_controls must be a number (e.g. 41944), not a column name. For a per-SNP sample size column use n_col",
                "meta": ["n_controls"]
            },
            "pop_prev": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1,
                "errorMessage": "pop_prev must be between 0 and 1",
                "meta": ["pop_prev"]
            },
            "sep": {
                "type": "string",
                "enum": ["tab", "comma", "space"],
                "errorMessage": "sep must be 'tab', 'comma' or 'space' (leave empty for tab)",
                "meta": ["sep"]
            },
            "snp_col":  { "type": "string", "meta": ["snp_col"] },
            "chr_col":  { "type": "string", "meta": ["chr_col"] },
            "pos_col":  { "type": "string", "meta": ["pos_col"] },
            "a1_col":   { "type": "string", "meta": ["a1_col"] },
            "a2_col":   { "type": "string", "meta": ["a2_col"] },
            "beta_col": { "type": "string", "meta": ["beta_col"] },
            "se_col":   { "type": "string", "meta": ["se_col"] },
            "pval_col": { "type": "string", "meta": ["pval_col"] },
            "freq_col": { "type": "string", "meta": ["freq_col"] },
            "info_col": { "type": "string", "meta": ["info_col"] },
            "n_col":    { "type": "string", "meta": ["n_col"] }
        },
        "required": [
            "trait", "sumstats", "build", "trait_type",
            "snp_col", "chr_col", "pos_col", "a1_col", "a2_col", "beta_col", "se_col", "pval_col"
        ],
        "allOf": [
            {
                "if": { "properties": { "trait_type": { "const": "quant" } } },
                "then": {
                    "anyOf": [ { "required": ["n"] }, { "required": ["n_col"] } ],
                    "errorMessage": "quant traits need either n or n_col"
                }
            },
            {
                "if": { "properties": { "trait_type": { "const": "cc" } } },
                "then": {
                    "anyOf": [ { "required": ["n_cases", "n_controls"] }, { "required": ["n_col"] } ],
                    "errorMessage": "cc traits need n_cases + n_controls, or n_col"
                }
            }
        ]
    }
}
